<?import javafx.scene.layout.Region?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="250.0" spacing="10.0" style="-fx-background-color: #111827;" stylesheets="@sidebar-style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.saveit.controller.SideBarController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <padding>
                <Insets bottom="30.0" left="20.0" right="20.0" top="30.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" style="-fx-background-color: #10B981; -fx-background-radius: 8;">
                    <children>
                        <SVGPath content="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
