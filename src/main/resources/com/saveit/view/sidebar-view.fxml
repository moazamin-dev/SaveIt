                    </padding>
                </VBox>
                <VBox>
                    <children>
                        <Label text="BudgetPro" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Label text="EXPERT ADVISOR" textFill="#9ca3af">
                            <font>
                                <Font size="10.0" />
                            </font>
                        </Label>
