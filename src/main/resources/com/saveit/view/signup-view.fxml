<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.image.Image?>

<HBox alignment="CENTER" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.saveit.controller.SignUpController">
    <children>

        <VBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #121921;" HBox.hgrow="ALWAYS" maxWidth="500.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <Label text="SaveIt" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>
                <Label text="Precision financial management for the modern professional. Join thousands of users optimizing their wealth today." textFill="#94a3b8" wrapText="true">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Region VBox.vgrow="ALWAYS" />
                <HBox spacing="15.0" alignment="CENTER_LEFT">
                    <children>
                        <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../logo.png" />
                            </image>
                            <clip>
                                <Rectangle arcHeight="20.0" arcWidth="20.0" height="60.0" width="60.0" />
                            </clip>
                        </ImageView>
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Bank-grade security" textFill="WHITE" />
                                <Label text="Your data is always encrypted" textFill="#64748b">
                                    <font>
                                        <Font size="10.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox alignment="CENTER_LEFT" spacing="15.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
            </padding>
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Create an account">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label text="Start your journey toward financial freedom." textFill="#64748b" />
                    </children>
                </VBox>

                <Label fx:id="errorLabel" textFill="#ef4444" wrapText="true" />

                <GridPane hgap="15.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>
                    <children>
                        <VBox spacing="5.0" GridPane.columnIndex="0">
                            <children>
                                <Label text="FULL NAME" />
                                <TextField fx:id="nameField" promptText="John Doe" style="-fx-padding: 10;" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1">
                            <children>
                                <Label text="USERNAME" />
                                <TextField fx:id="usernameField" promptText="johndoe88" style="-fx-padding: 10;" />
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <VBox spacing="5.0">
                    <children>
                        <Label text="PHONE NUMBER" />
                        <TextField fx:id="phoneField" promptText="+1 234 567 890" style="-fx-padding: 10;" />
                    </children>
                </VBox>

                <GridPane hgap="15.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>
                    <children>
                        <VBox spacing="5.0" GridPane.columnIndex="0">
                            <children>
                                <Label text="PASSWORD" />
                                <PasswordField fx:id="passwordField" promptText="••••••••" style="-fx-padding: 10;" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1">
                            <children>
                                <Label text="CONFIRM PASSWORD" />
                                <PasswordField fx:id="confirmPasswordField" promptText="••••••••" style="-fx-padding: 10;" />
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <Button maxWidth="Infinity" onAction="#handleRegister" style="-fx-background-color: #000000; -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 5; -fx-cursor: hand;" text="Register →">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>

                <HBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label text="Already have an account?" textFill="#64748b" />
                        <Hyperlink onAction="#backToLogin" style="-fx-text-fill: #000000; -fx-font-weight: bold;" text="Back to Login" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>