<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.saveit.controller.BudgetSetupController"
           styleClass="screen-bg"
           stylesheets="@budget-setup.css">

    <VBox styleClass="card" maxWidth="460" alignment="TOP_CENTER">
        <StackPane.margin><Insets top="44" bottom="44"/></StackPane.margin>

        <!-- ── Header ── -->
        <VBox styleClass="card-top" spacing="5">
            <HBox alignment="CENTER_LEFT" spacing="0">
                <Label text="SAVEIT" styleClass="eyebrow"/>
                <Label text="Active" styleClass="badge"/>
            </HBox>
            <Label text="Budget Setup"                              styleClass="card-title"/>
            <Label text="Define your spending limit and cycle dates." styleClass="card-subtitle" wrapText="true"/>
        </VBox>

        <Region styleClass="h-divider"/>

        <!-- ── Form ── -->
        <VBox styleClass="form-section" spacing="20">

            <!-- Monthly limit -->
            <VBox spacing="7">
                <Label text="MONTHLY LIMIT" styleClass="field-label"/>
                <HBox styleClass="input-group" alignment="CENTER_LEFT">
                    <Label text="💰" styleClass="input-prefix"/>
                    <TextField fx:id="limitField"
                               promptText="0.00"
                               styleClass="input-inline"/>
                </HBox>
            </VBox>

            <!-- Date row -->
            <HBox spacing="14">
                <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label text="START DATE" styleClass="field-label"/>
                    <DatePicker fx:id="startPicker" promptText="Select date"
                                styleClass="date-picker" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <Label text="END DATE" styleClass="field-label"/>
                    <DatePicker fx:id="endPicker" promptText="Select date"
                                styleClass="date-picker" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <!-- Error -->
            <Label fx:id="errorLabel" text="" styleClass="error-label"
                   wrapText="true" maxWidth="388"/>

            <!-- ── Section separator ── -->
            <HBox alignment="CENTER" spacing="12">
                <Region HBox.hgrow="ALWAYS" styleClass="sep-line"/>
                <Label text="SPENDING STATUS" styleClass="sep-label"/>
                <Region HBox.hgrow="ALWAYS" styleClass="sep-line"/>
            </HBox>

            <!-- Stat cards row -->
            <HBox spacing="10">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Spent"     styleClass="stat-label"/>
                    <Label fx:id="spentStatLabel" text="—" styleClass="stat-val-green"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Remaining" styleClass="stat-label"/>
                    <Label fx:id="remainingStatLabel" text="—" styleClass="stat-val"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label text="Used"      styleClass="stat-label"/>
                    <Label fx:id="usedPctLabel" text="—" styleClass="stat-val"/>
                </VBox>
            </HBox>

            <!-- Progress bar -->
            <VBox spacing="7">
                <HBox>
                    <Label text="Cycle progress" styleClass="progress-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="amountLabel" text="— of —" styleClass="progress-amount"/>
                </HBox>
                <ProgressBar fx:id="budgetProgress" progress="0"
                             maxWidth="Infinity" styleClass="budget-progress"/>
                <HBox>
                    <Label fx:id="statusPercentLabel" text="" styleClass="progress-foot-status"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="remainingLabel"     text="" styleClass="progress-foot-days"/>
                </HBox>
            </VBox>

            <!-- Notification badge -->
            <HBox fx:id="notificationPane" styleClass="notif-pill"
                  spacing="10" alignment="TOP_LEFT">
                <Circle fx:id="notifDot" radius="3.5" styleClass="dot-neutral"/>
                <VBox spacing="3">
                    <Label fx:id="notifTitle"        text="No data yet"
                           styleClass="notif-title"/>
                    <Label fx:id="notificationLabel" text="Start a cycle to see spending status."
                           styleClass="notif-body" wrapText="true" maxWidth="320"/>
                </VBox>
            </HBox>

        </VBox>

        <!-- ── Footer buttons ── -->
        <VBox styleClass="card-footer" spacing="10">
            <Button text="Start Budget Cycle"
                    onAction="#handleStartCycle"
                    styleClass="btn-primary"
                    maxWidth="Infinity"/>
            <Button text="Reset Cycle"
                    onAction="#handleReset"
                    styleClass="btn-ghost"
                    maxWidth="Infinity"/>
        </VBox>

    </VBox>
</StackPane>