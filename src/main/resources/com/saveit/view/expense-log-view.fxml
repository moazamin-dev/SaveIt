<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<HBox prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f8fafc;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.saveit.controller.ExpenseLogController">
    <children>

        <fx:include source="sidebar-view.fxml" />

        <VBox HBox.hgrow="ALWAYS" spacing="25.0">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="20.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label text="Expense Log" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <HBox spacing="20.0">
                    <children>
                        <VBox prefWidth="320.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                            <padding><Insets top="25" right="25" bottom="25" left="25" /></padding>
                            <children>
                                <Label text="TOTAL SPENT" textFill="#64748b" style="-fx-font-weight: bold; -fx-font-size: 12;" />
                                <Label text="\$0.00" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                                <Label text="↗ 12% from last month" textFill="#10b981" style="-fx-font-weight: bold; -fx-font-size: 13;" />
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Label text="Transaction History" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <ComboBox fx:id="categoryFilter" promptText="All Categories" prefWidth="180.0"
                                          style="-fx-background-color: #f1f5f9; -fx-background-radius: 8;" />
                                <Button text="+ Add Expense"
                                        style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;" />
                            </children>
                            <VBox.margin><Insets bottom="15" /></VBox.margin>
                        </HBox>

                        <Separator style="-fx-opacity: 0.5;" />

                        <TableView fx:id="expenseTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-selection-bar: #f1f5f9;">
                            <columns>
                                <TableColumn fx:id="colDate" text="DATE" prefWidth="130" />
                                <TableColumn fx:id="colDescription" text="DESCRIPTION" prefWidth="350" />
                                <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="150" />
                                <TableColumn fx:id="colAmount" text="AMOUNT" prefWidth="130" />
                                <TableColumn fx:id="colAction" text="ACTION" prefWidth="100" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <VBox.margin><Insets top="10" /></VBox.margin>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 15 0 0 0;">
                            <children>
                                <Label text="Showing latest transactions" textFill="#64748b" style="-fx-font-size: 12;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>