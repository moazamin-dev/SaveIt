<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="Expense_log" prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.saveit.controller.ExpenseLogController">
    <children>

        <fx:include source="sidebar-view.fxml" />

        <VBox spacing="25.0" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="20.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Expense Log" />
                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <HBox spacing="20.0">
                    <children>
                        <VBox prefWidth="320.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                            <padding><Insets bottom="25" left="25" right="25" top="25" /></padding>
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 12;" text="TOTAL SPENT" textFill="#64748b" />
                                <Label fx:id="totalSpentLabel" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="\$0.00" />
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Transaction History" />
                                <Region HBox.hgrow="ALWAYS" />
                                <ComboBox fx:id="categoryFilter" prefWidth="180.0" promptText="All Categories" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8;" />
                                <Button onAction="#handleDeleteExpense" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;" text="Delete Selected" />
                                <Button onAction="#goToAddExpense" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;" text="+ Add Expense" />
                            </children>
                            <VBox.margin><Insets bottom="15" /></VBox.margin>
                        </HBox>

                        <Separator style="-fx-opacity: 0.5;" />

                        <TableView fx:id="expenseTable" style="-fx-background-color: transparent; -fx-selection-bar: #f1f5f9;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colDate" prefWidth="130" text="DATE" />
                                <TableColumn fx:id="colDescription" prefWidth="350" text="DESCRIPTION" />
                                <TableColumn fx:id="colCategory" prefWidth="150" text="CATEGORY" />
                                <TableColumn fx:id="colAmount" prefWidth="130" text="AMOUNT" />
                                <TableColumn fx:id="colAction" prefWidth="100" text="ACTION" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <VBox.margin><Insets top="10" /></VBox.margin>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 15 0 0 0;">
                            <children>
                                <Label style="-fx-font-size: 12;" text="Showing latest transactions" textFill="#64748b" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>
